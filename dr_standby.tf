# synthetic: true - generated by `emissiongate estate`. Not real infrastructure; plans never
# contact AWS (dummy credentials, no data sources, local state only).

resource "aws_launch_template" "dr_standby" {
  provider      = aws.us_west_2
  name          = "eg-dr-standby"
  image_id      = var.ami_x86_64
  instance_type = "m5.2xlarge"
}

resource "aws_autoscaling_group" "dr_standby" {
  provider           = aws.us_west_2
  name               = "eg-dr-standby"
  availability_zones = ["us-west-2a", "us-west-2b"]
  min_size           = 2
  max_size           = 2
  desired_capacity   = 2

  launch_template {
    id      = aws_launch_template.dr_standby.id
    version = "$Latest"
  }

  tag {
    key                 = "Environment"
    value               = "prod"
    propagate_at_launch = true
  }

  tag {
    key                 = "Role"
    value               = "DR"
    propagate_at_launch = true
  }
}

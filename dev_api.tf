# synthetic: true - generated by `emissiongate estate`. Not real infrastructure; plans never
# contact AWS (dummy credentials, no data sources, local state only).

resource "aws_launch_template" "dev_api" {
  provider      = aws.eu_west_2
  name          = "eg-dev-api"
  image_id      = var.ami_x86_64
  instance_type = "m5.large"
}

resource "aws_autoscaling_group" "dev_api" {
  provider           = aws.eu_west_2
  name               = "eg-dev-api"
  availability_zones = ["eu-west-2a", "eu-west-2b"]
  min_size           = 12
  max_size           = 12
  desired_capacity   = 12

  launch_template {
    id      = aws_launch_template.dev_api.id
    version = "$Latest"
  }

  tag {
    key                 = "Environment"
    value               = "dev"
    propagate_at_launch = true
  }

  tag {
    key                 = "Owner"
    value               = "web"
    propagate_at_launch = true
  }
}

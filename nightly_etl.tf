# synthetic: true - generated by `emissiongate estate`. Not real infrastructure; plans never
# contact AWS (dummy credentials, no data sources, local state only).

resource "aws_launch_template" "nightly_etl" {
  provider      = aws.eu_west_2
  name          = "eg-nightly-etl"
  image_id      = var.ami_x86_64
  instance_type = "c5.2xlarge"
}

resource "aws_autoscaling_group" "nightly_etl" {
  provider           = aws.eu_west_2
  name               = "eg-nightly-etl"
  availability_zones = ["eu-west-2a", "eu-west-2b"]
  min_size           = 0
  max_size           = 4
  desired_capacity   = 0

  launch_template {
    id      = aws_launch_template.nightly_etl.id
    version = "$Latest"
  }

  tag {
    key                 = "Environment"
    value               = "prod"
    propagate_at_launch = true
  }

  tag {
    key                 = "Owner"
    value               = "data"
    propagate_at_launch = true
  }
}

resource "aws_autoscaling_schedule" "nightly_etl_up" {
  provider               = aws.eu_west_2
  scheduled_action_name  = "nightly-etl-up"
  autoscaling_group_name = aws_autoscaling_group.nightly_etl.name
  recurrence             = "0 2 * * *"
  time_zone              = "Europe/London"
  min_size               = 4
  max_size               = 4
  desired_capacity       = 4
}

resource "aws_autoscaling_schedule" "nightly_etl_down" {
  provider               = aws.eu_west_2
  scheduled_action_name  = "nightly-etl-down"
  autoscaling_group_name = aws_autoscaling_group.nightly_etl.name
  recurrence             = "0 4 * * *"
  time_zone              = "Europe/London"
  min_size               = 0
  max_size               = 0
  desired_capacity       = 0
}

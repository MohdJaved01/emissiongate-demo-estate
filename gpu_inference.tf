# synthetic: true - generated by `emissiongate estate`. Not real infrastructure; plans never
# contact AWS (dummy credentials, no data sources, local state only).

resource "aws_launch_template" "gpu_inference" {
  provider      = aws.us_east_1
  name          = "eg-gpu-inference"
  image_id      = var.ami_x86_64
  instance_type = "g5.2xlarge"
}

resource "aws_autoscaling_group" "gpu_inference" {
  provider           = aws.us_east_1
  name               = "eg-gpu-inference"
  availability_zones = ["us-east-1a", "us-east-1b"]
  min_size           = 4
  max_size           = 4
  desired_capacity   = 4

  launch_template {
    id      = aws_launch_template.gpu_inference.id
    version = "$Latest"
  }

  tag {
    key                 = "Environment"
    value               = "staging"
    propagate_at_launch = true
  }

  tag {
    key                 = "Owner"
    value               = "ml-platform"
    propagate_at_launch = true
  }
}

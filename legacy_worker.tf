# synthetic: true - generated by `emissiongate estate`. Not real infrastructure; plans never
# contact AWS (dummy credentials, no data sources, local state only).

resource "aws_launch_template" "legacy_worker" {
  provider      = aws.eu_west_1
  name          = "eg-legacy-worker"
  image_id      = var.ami_x86_64
  instance_type = "m5.2xlarge"
}

resource "aws_autoscaling_group" "legacy_worker" {
  provider           = aws.eu_west_1
  name               = "eg-legacy-worker"
  availability_zones = ["eu-west-1a", "eu-west-1b"]
  min_size           = 6
  max_size           = 6
  desired_capacity   = 6

  launch_template {
    id      = aws_launch_template.legacy_worker.id
    version = "$Latest"
  }

  tag {
    key                 = "Environment"
    value               = "prod"
    propagate_at_launch = true
  }

  tag {
    key                 = "Owner"
    value               = "data"
    propagate_at_launch = true
  }
}

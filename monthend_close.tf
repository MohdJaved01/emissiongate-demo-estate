# synthetic: true - generated by `emissiongate estate`. Not real infrastructure; plans never
# contact AWS (dummy credentials, no data sources, local state only).

resource "aws_launch_template" "monthend_close" {
  provider      = aws.eu_west_1
  name          = "eg-monthend-close"
  image_id      = var.ami_x86_64
  instance_type = "c5.4xlarge"
}

resource "aws_autoscaling_group" "monthend_close" {
  provider           = aws.eu_west_1
  name               = "eg-monthend-close"
  availability_zones = ["eu-west-1a", "eu-west-1b"]
  min_size           = 3
  max_size           = 3
  desired_capacity   = 3

  launch_template {
    id      = aws_launch_template.monthend_close.id
    version = "$Latest"
  }

  tag {
    key                 = "Environment"
    value               = "prod"
    propagate_at_launch = true
  }

  tag {
    key                 = "Owner"
    value               = "finance"
    propagate_at_launch = true
  }
}

# synthetic: true - generated by `emissiongate estate`. Not real infrastructure; plans never
# contact AWS (dummy credentials, no data sources, local state only).

resource "aws_launch_template" "prod_api" {
  provider      = aws.eu_west_1
  name          = "eg-prod-api"
  image_id      = var.ami_arm64
  instance_type = "m7g.xlarge"
}

resource "aws_autoscaling_group" "prod_api" {
  provider           = aws.eu_west_1
  name               = "eg-prod-api"
  availability_zones = ["eu-west-1a", "eu-west-1b"]
  min_size           = 4
  max_size           = 4
  desired_capacity   = 4

  launch_template {
    id      = aws_launch_template.prod_api.id
    version = "$Latest"
  }

  tag {
    key                 = "Environment"
    value               = "prod"
    propagate_at_launch = true
  }

  tag {
    key                 = "Owner"
    value               = "web"
    propagate_at_launch = true
  }
}
